<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_background_dark"
    android:fillViewport="true"
    tools:context=".ui.player.PlayerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- ==================== HERO ALBUM ART AREA ==================== -->

        <!-- Glow behind album art -->
        <View
            android:id="@+id/album_glow"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/album_art_glow"
            android:alpha="0.6"
            app:layout_constraintTop_toTopOf="@id/album_art_card"
            app:layout_constraintBottom_toBottomOf="@id/album_art_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Album art card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/album_art_card"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/surface_elevated"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/album_art_placeholder_bg">

                <ImageView
                    android:id="@+id/iv_album_art"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_album_art_placeholder"
                    android:contentDescription="Album Art" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== TRACK INFO ==================== -->

        <TextView
            android:id="@+id/tv_current_track_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="No track playing"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/album_art_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ==================== PROGRESS ==================== -->

        <SeekBar
            android:id="@+id/sb_track_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:progressTint="@color/accent_primary"
            android:progressBackgroundTint="@color/seekbar_track"
            android:thumbTint="@color/accent_primary"
            app:layout_constraintTop_toBottomOf="@id/tv_current_track_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ==================== CONTROL BUTTONS ==================== -->

        <LinearLayout
            android:id="@+id/layout_controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/sb_track_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btn_previous_track"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/control_button_bg"
                android:contentDescription="Previous"
                android:padding="14dp"
                android:src="@drawable/ic_btn_prev"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/control_button_play_bg"
                android:contentDescription="Play/Pause"
                android:padding="18dp"
                android:src="@drawable/winamp_btn_play"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btn_next_track"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/control_button_bg"
                android:contentDescription="Next"
                android:padding="14dp"
                android:src="@drawable/ic_btn_next"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btn_stop_track"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/control_button_bg"
                android:contentDescription="Stop"
                android:padding="14dp"
                android:src="@drawable/ic_btn_stop"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btn_eject"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/control_button_bg"
                android:contentDescription="Eject"
                android:padding="14dp"
                android:src="@drawable/ic_btn_eject"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- ==================== VOLUME ==================== -->

        <LinearLayout
            android:id="@+id/layout_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/volume_bar_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/layout_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOL"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:layout_marginEnd="12dp" />

            <SeekBar
                android:id="@+id/sb_volume_control"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_secondary"
                android:progressBackgroundTint="@color/seekbar_track"
                android:thumbTint="@color/accent_secondary" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
