<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_background_dark"
    tools:context=".ui.visualizer.VisualizerFragment">

    <VideoView
        android:id="@+id/video_view_visualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/pulse_glow"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:alpha="0.45"
        android:background="@drawable/visualizer_glow" />

    <!-- Subtle vignette overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/visualizer_vignette"
        android:alpha="0.4" />

</FrameLayout>
