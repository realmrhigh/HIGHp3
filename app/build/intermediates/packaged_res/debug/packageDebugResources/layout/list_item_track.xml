<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_item_selector"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Track number / music icon -->
        <ImageView
            android:id="@+id/iv_track_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_music_note"
            android:padding="6dp"
            android:background="@drawable/control_button_bg"
            app:tint="@color/accent_primary"
            android:contentDescription="Track"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/winamp_playlist_text_normal"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_track_icon"
            app:layout_constraintEnd_toStartOf="@id/tv_track_duration"
            tools:text="Track Title" />

        <TextView
            android:id="@+id/tv_track_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_track_title"
            app:layout_constraintStart_toEndOf="@id/iv_track_icon"
            app:layout_constraintEnd_toStartOf="@id/tv_track_duration"
            android:layout_marginEnd="8dp"
            tools:text="Artist Name" />

        <TextView
            android:id="@+id/tv_track_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="03:45" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
