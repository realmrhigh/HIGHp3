<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_playlist_background"
    tools:context=".ui.player.PlayerFragment">

    <!-- Current Track Info -->
    <TextView
        android:id="@+id/tv_current_track_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No track playing"
        android:textSize="18sp"
        android:textColor="@color/winamp_text_green"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Track Progress SeekBar -->
    <SeekBar
        android:id="@+id/sb_track_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        app:layout_constraintTop_toBottomOf="@id/tv_current_track_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Track progress"/>
    <!-- Note: max value is set dynamically based on track duration in PlayerFragment -->

    <!-- Playback Controls -->
    <LinearLayout
        android:id="@+id/playback_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/sb_track_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/btn_previous_track"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/back"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Previous track"
            android:layout_margin="8dp"/>

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/winamp_btn_play"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Play or pause"
            android:layout_margin="8dp"/>

        <!-- Stop Button -->
        <ImageButton
            android:id="@+id/btn_stop_track"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/stop"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Stop playback"
            android:layout_margin="8dp"/>

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/btn_next_track"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/skip"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Next track"
            android:layout_margin="8dp"/>

    </LinearLayout>

    <!-- Eject Button -->
    <ImageButton
        android:id="@+id/btn_eject"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/eject"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:contentDescription="Open playlist"
        app:layout_constraintTop_toBottomOf="@id/playback_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Volume Control Label -->
    <TextView
        android:id="@+id/tv_volume_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volume"
        android:textSize="14sp"
        android:textColor="@color/winamp_text_green"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/btn_eject"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"/>

    <!-- Volume Control SeekBar -->
    <SeekBar
        android:id="@+id/sb_volume_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="15"
        android:progress="7"
        app:layout_constraintTop_toBottomOf="@id/tv_volume_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Volume control"/>

</androidx.constraintlayout.widget.ConstraintLayout>
